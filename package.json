{
  "name": "dentalbase-e2e",
  "version": "2.0.0",
  "description": "DentalBase E2E test suite — TypeScript + Playwright",
  "scripts": {
    "test": "npx playwright test",
    "test:coverage": "npx playwright test tests/insurance-billing/coverage.spec.ts",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "auth": "npx playwright test tests/auth.setup.ts --project=setup"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^26.1.1",
    "dotenv": "^16.0.0",
    "typescript": "^5.5.0"
  }
}
